# 複製成 .env 後填入真實數值（.env 已被 .gitignore 排除，切勿提交）
PORT=3000
NODE_ENV=development

# MongoDB 連線字串（例如 MongoDB Atlas）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT 簽章密鑰：請用至少 32 字元的隨機字串
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 允許跨域的前端網址，多個以逗號分隔
CORS_ORIGIN=http://localhost:5173,https://sale.lifemochi.com

# 管理員帳號（僅供 npm run create-admin 使用）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# ATM 轉帳收款帳號（選填；未設定時前台顯示「展示用」假帳號）
ATM_BANK_CODE=
ATM_BANK_NAME=
ATM_ACCOUNT=
ATM_ACCOUNT_NAME=

# 忘記密碼寄信（Resend，https://resend.com）。未設定時不寄信，本機開發會把信件內容印在終端機
RESEND_API_KEY=
MAIL_FROM=
# 重設密碼信中的前端網址（未設定時取 CORS_ORIGIN 中第一個 https 網址）
APP_URL=
